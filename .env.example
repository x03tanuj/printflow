# ==========================================
# PrintFlow Environment Configuration (.env)
# ==========================================

# -----------------
# Infrastructure
# -----------------
# PostgreSQL Configuration
POSTGRES_USER=printflow
POSTGRES_PASSWORD=printflow_dev_password
POSTGRES_DB=printflow
POSTGRES_PORT=5432

# MinIO (S3-compatible Object Storage) Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=printflow-orders

# -----------------
# API (apps/api)
# -----------------
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Database URL
DATABASE_URL=postgresql+psycopg://printflow:printflow_dev_password@localhost:5432/printflow

# Storage Settings (MinIO for local dev, Cloudflare R2 for production)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_dev_password
STORAGE_BUCKET_NAME=printflow-orders

# Razorpay (Development Test Keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# -----------------
# Web (apps/web)
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# -----------------
# Shop Agent (apps/agent)
# -----------------
PRINTFLOW_API_URL=ws://localhost:8000/ws/agent
PRINTFLOW_AGENT_TOKEN=placeholder_agent_auth_token
